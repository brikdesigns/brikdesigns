# 1Password env-file for `op run` — resolves the credentials needed to install
# and build this repo, so no value has to live in shell env.
#
# Usage:
#   op run --env-file=.env.op -- npm install
#   op run --env-file=.env.op -- npm ci
#   op run --env-file=.env.op -- npm run build
#
# Why: PACKAGES_READ_TOKEN (a GitHub PAT with read:packages scope) authenticates
# `@brikdesigns/*` package pulls from GitHub Packages via .npmrc substitution.
# Previously sourced from ~/.zshenv → ~/.secrets/brik-packages.env, leaving it
# exposed to any `env | grep`-style command from an agent or shell session
# (brik-llm#593 — 2026-05-22 PAT leak). Resolving via op-run keeps the value
# in 1Password until the moment npm spawns and drops it after the child exits.
#
# 1P item purpose: `packages-read` (brik-llm/operations/security/secrets.yaml).
# CI is unaffected — GH Actions and Netlify supply PACKAGES_READ_TOKEN directly
# as repo/site env; `op run` is a developer-machine concern only.
#
# Tracking: brikdesigns#253 (this repo), brik-llm#570 (cross-repo audit).

PACKAGES_READ_TOKEN=op://Development/lgpwdjwwdndjneddgjqafeb4eq/credential

# ── Supabase (build-time) ────────────────────────────────────────────────────
# `npm run build` renders the marketing pages at build time, so every CMS page
# needs a Supabase client during `Collecting page data`. Without these the build
# dies with "Your project's URL and Key are required to create a Supabase
# client!" — which meant CLAUDE.md's "Before pushing: run npm run build" gate
# could not run from a fresh clone at all (brikdesigns#765).
#
# The project is the SHARED staging project, also used by brik-client-portal and
# brik-rag. 1P item purpose: `supabase-shared-staging-anon`
# (brik-llm/operations/security/secrets.yaml) — inspect with
# `brik-secrets show supabase-shared-staging-anon`.
#
# The URL is not a secret (it ships in every client bundle and already appears
# literally in scripts/gen-types.mjs:20), so it is inline rather than an op://
# ref — the 1P item has no populated field for it.
NEXT_PUBLIC_SUPABASE_URL=https://lmhzpzobdkstzpvsqest.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=op://Development/mtotlsdi2vut6amn4e775ibux4/anon-key
